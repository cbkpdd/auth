{
  "name": "kpdd-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KPDD auth service: sign-in, tokens and permissions for KPDD apps",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "auth:keys": "node --env-file-if-exists=.env scripts/keys.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0"
  }
}
