# Copy to .env and fill in. Never commit .env.
PORT=4000
# SQLite file; data/ is untracked
DATABASE_PATH=data/auth.db
AUTH_ISSUER=https://auth.kpdd.com
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_MASTER_KEY=
DASH_WEBHOOK_SECRET=
# Staff directory API on kpdd.com (docs/kpdd-api.md)
KPDD_API_URL=https://kpdd.com/api/internal
KPDD_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
EMAIL_API_KEY=
